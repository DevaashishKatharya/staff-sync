# ==========================================
# StaffSync HRM - Environment Variables Guide
# ==========================================

# 1. MongoDB Connection String (Required for production / Vercel)
# Create a free cluster on MongoDB Atlas (https://www.mongodb.com/atlas)
# Ensure Network Access IP Whitelist includes '0.0.0.0/0' (Allow Access from Anywhere) for Vercel Serverless
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/staffsync?retryWrites=true&w=majority

# 2. JWT Secret Key (Required for secure token signing)
# Generate a random 32+ character string
JWT_SECRET=staffsync_super_secret_jwt_production_key_2026

# 3. Server Port (Used for local standalone server)
PORT=5001

# 4. Node Environment
NODE_ENV=production

# 5. Client API URL (Optional - only needed if deploying frontend & backend separately)
# Leave blank or omit for unified monorepo deployment on Vercel
# VITE_API_URL=https://your-staffsync-app.vercel.app
