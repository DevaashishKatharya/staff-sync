{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "StaffSync - Enterprise Human Resource Management (HRM) System",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
